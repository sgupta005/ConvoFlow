{
  "name": "ConvoFlow - Meeting Transcription",
  "displayName": "ConvoFlow",
  "version": "0.0.1",
  "description": "Real-time transcription for Google Meet and Zoom meetings.",
  "author": "Shivam Gupta <shivamgupta05.dev@gmail.com>",
  "scripts": {
    "dev": "pnpm build:offscreen && concurrently \"pnpm watch:offscreen\" \"plasmo dev\"",
    "build": "pnpm build:offscreen && plasmo build",
    "build:offscreen": "node scripts/build-offscreen.mjs",
    "watch:offscreen": "node scripts/watch-offscreen.mjs",
    "package": "plasmo package",
    "postinstall": "node scripts/patch.js"
  },
  "dependencies": {
    "@plasmohq/messaging": "^0.7.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@workspace/contracts": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/ui": "workspace:*",
    "better-auth": "^1.4.10",
    "lucide-react": "^0.475.0",
    "plasmo": "0.90.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwindcss": "4.1.18",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "concurrently": "^9.1.2",
    "esbuild": "^0.24.2",
    "postcss": "8.4.33",
    "typescript": "5.3.3"
  },
  "manifest": {
    "permissions": [
      "tabCapture",
      "offscreen",
      "activeTab",
      "storage"
    ],
    "host_permissions": [
      "http://localhost:3000/*",
      "https://meet.google.com/*",
      "https://*.zoom.us/*"
    ],
    "web_accessible_resources": [
      {
        "resources": [
          "assets/offscreen.html",
          "assets/offscreen.js",
          "tabs/permission.html"
        ],
        "matches": [
          "<all_urls>"
        ]
      }
    ],
    "minimum_chrome_version": "116"
  }
}
